<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

    <!-- Log directory — defaults to /var/log/ambient (created in Dockerfile) -->
    <property name="LOG_DIR" value="${LOG_DIR:-/var/log/ambient}"/>

    <!-- File appender: WARN+ only — exceptions and errors, no routine INFO -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <file>${LOG_DIR}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger — INFO matches application-prod.yml intent -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

    <!-- Package-level suppression for framework chatter -->
    <logger name="io.micronaut" level="WARN"/>
    <logger name="io.micronaut.context" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.babyfish.jimmer.sql" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>

</configuration>
